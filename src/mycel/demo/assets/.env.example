# Hugging Face token with Inference Providers access (https://hf.co/settings/tokens)
HF_TOKEN=hf_your-token-here

# Optional: pin a specific inference provider (default: auto routing)
# HF_PROVIDER=groq

# Optional: model overrides (any tool-calling model served by HF Inference Providers)
# MYCEL_MODEL=moonshotai/Kimi-K2-Instruct     # default for everything
# NODE_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507   # Diplomat node agents
# PLANNER_MODEL=moonshotai/Kimi-K2-Instruct       # orchestrator planner + synthesizer
